[Unit]
Description=LM Studio private inference server
Wants=network-online.target
After=network-online.target

[Service]
# LM Studio's CLI starts its daemon/server in the background.  The unit stays
# active so hotel-chat can depend on it after the command has completed.
Type=oneshot
RemainAfterExit=yes
User=YOUR_LINUX_USER
Environment=HOME=/home/YOUR_LINUX_USER

# Install the standalone llmster runtime first:
# curl -fsSL https://lmstudio.ai/install.sh | bash
# Do not use the desktop-app-only CLI here; it needs a graphical login.
ExecStartPre=/home/YOUR_LINUX_USER/.lmstudio/bin/lms daemon up

# JIT model loading is enabled in LM Studio.  Do not hard-code an `lms load`
# target here: the OpenAI API identifier can differ from the local GGUF path.
# The first chat request loads the model selected by LLM_MODEL automatically.
ExecStart=/home/YOUR_LINUX_USER/.lmstudio/bin/lms server start --bind 127.0.0.1 --port 1234
ExecStop=/home/YOUR_LINUX_USER/.lmstudio/bin/lms daemon down
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
