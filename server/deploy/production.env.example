# The Node chat server runs on the same Ubuntu host as LM Studio.
# Keep it reachable only through Tailscale Funnel's local reverse proxy.
PORT=3001
HOST=127.0.0.1

# Public browser origin only. Do not add a path such as /HotelProject.
CORS_ORIGINS=https://drowsyzzz.github.io

# LM Studio stays private on the same Ubuntu machine.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen/qwen3.5-9b
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048

# Read-only hotel data. Use the Supabase publishable key; never use a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_REQUEST_TIMEOUT_MS=10000

CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=30
