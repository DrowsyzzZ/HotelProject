# HTTP server
PORT=3001
HOST=127.0.0.1

# Comma-separated browser origins permitted to call this API.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# LM Studio OpenAI-compatible API. Never expose these values in src/.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen/qwen3.5-9b
# Leave blank unless the LM Studio endpoint is configured to require a key.
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.4
# Qwen 3.5 may use internal reasoning before producing its final answer.
LLM_MAX_TOKENS=2048

# Basic public API protection
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_REQUESTS=30
